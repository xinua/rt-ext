{
  "name": "rt-ext",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node scripts/dev.mjs --target=chrome",
    "dev:firefox": "node scripts/dev.mjs --target=firefox",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "test": "ng test",
    "lint": "ng lint",
    "prettier": "prettier --write .",
    "format": "pnpm run prettier && pnpm run lint"
  },
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "angular-notifier": "^14.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/chrome": "^0.3.0",
    "@types/node": "^20.17.19",
    "@types/ws": "^8.18.1",
    "angular-eslint": "22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8",
    "web-ext": "^10.7.0",
    "ws": "^8.21.3"
  }
}
